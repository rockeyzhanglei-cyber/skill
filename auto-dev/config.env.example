#!/bin/bash
# auto-dev 环境配置
# 取消注释并填入实际值
# export WECHAT_WEBHOOK_URL="https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=YOUR-KEY-HERE"

# WinMetrics 埋点配置
export WM_METRICS_API="https://wxpcpp.winning.com.cn:2443/winmetrics/api/events"
